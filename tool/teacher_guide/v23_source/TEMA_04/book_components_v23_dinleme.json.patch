+    "T4_G04_P294_295_YAPI_DIL": {"q1_yapi_unsurlari":{"value":"Ses, görsel, ışık, mekân ve zaman unsurları videoda gerçekten görülen/duyulan örneklerle belirlenir; rehber video izlenmeden somut unsur listesi üretmez.","source_locator":"basılı s.294 / PDF s.295 — Çözümleyebilme soru 1 / QR video gerekli"},"q2_yapi_islev":{"value":"Q1'de belirlenen yapı unsurunun içerikle hangi ilişkiyi kurduğu açıklanır: bilgi verme, atmosfer, vurgu, zaman/mekân kurma, duygu veya dikkat yönlendirme gibi işlevler yalnız gerçek medya örneğiyle gerekçelendirilir.","source_locator":"basılı s.294 / PDF s.295 — Çözümleyebilme soru 2 / QR video gerekli"},"q3_yapi_katki":{"value":"Yapı unsurlarının katkısı 'olmasa ne eksilirdi?' karşılaştırmasıyla değerlendirilebilir; bilgi, atmosfer, inandırıcılık veya anlam katmanındaki değişim videodan kanıtlanır.","source_locator":"basılı s.294 / PDF s.295 — Çözümleyebilme soru 3 / QR video gerekli"},"q4_unsur_iliskileri":{"value":{"gorsel_ses":"Aynı anın görüntü ve sesinin birbirini nasıl tamamladığı videodan örneklenir.","gorsel_nesne":"Gösterilen nesnenin bilgi/ileti açısından işlevi belirlenir.","gorsel_mekan":"Görüntünün mekânı nasıl kurduğu ve içeriğe nasıl bağladığı açıklanır.","ses_mekan":"Sesin mekân duygusu, atmosfer veya bağlam üretimine katkısı değerlendirilir.","ses_kisiler":"Ses, ton veya konuşmanın kişiyi/rolü/duyguyu nasıl görünür kıldığı kanıtlanır."},"source_locator":"basılı s.294 / PDF s.295 — Çözümleyebilme soru 4/a-d / QR video gerekli"},"q5_dil_anlatim_gunluk":{"value":"Dil/anlatım özellikleri videodan seçilir; içerikle işlevi açıklanır ve öğrencinin günlük dil kullanımıyla örtüşen/ayrışan yönleri gerekçelendirilir. Video izlenmeden belirli üslup etiketi verilmez.","source_locator":"basılı s.294 / PDF s.295 — Çözümleyebilme soru 5 / QR video gerekli"},"q6_dil_ileti":{"value":"Kullanılan dilin açık/örtük iletileri ne ölçüde görünür kıldığı, seçilen gerçek söz/ifade ile ileti arasındaki bağ üzerinden değerlendirilir.","source_locator":"basılı s.294 / PDF s.295 — Çözümleyebilme soru 6 / QR video gerekli"},"q7_dil_islevleri":{"value":"Dil işlevleri videodaki gerçek sözlerden hareketle belirlenir; bilgi verme, çağrı, duygu aktarma veya ilişki kurma gibi etiketler ancak metindeki kullanım bağlamıyla gerekçelendirilir.","source_locator":"basılı s.295 / PDF s.296 — Çözümleyebilme soru 7 / QR video gerekli"},"q8_karakter_ozellik_amac":{"value":"Karakter/kişinin özellik ve amacı video izlenmeden doldurulmaz. Her özellik veya amaç gözlenen söz, davranış, seçim ya da olay içindeki rolüyle desteklenmelidir.","source_locator":"basılı s.295 / PDF s.296 — Çözümleyebilme soru 8 / QR video gerekli"},"q9_ileti_unsur_islev":{"value":"Görsel, ses, nesne ve mekânın iletileri vermedeki işlevi ayrı ayrı değerlendirilir; her satırda videodan somut örnek + o örneğin iletiye katkısı birlikte yazılır.","source_locator":"basılı s.295 / PDF s.296 — Çözümleyebilme soru 9 / QR video gerekli"},"q10_donem_ozellik":{"value":"Belgeselde konu edilen dönemin sosyal, ekonomik ve kültürel özellikleri yalnız videoda görülen/duyulan nesne, çalışma düzeni, mekân, ilişki, söz veya yaşam koşulu kanıtlarından çıkarılır.","source_locator":"basılı s.295 / PDF s.296 — Çözümleyebilme soru 10 / QR video gerekli"},"q11_donem_toplum_iliskisi":{"value":"İçerik, yapı unsurları ve dil/anlatım ile dönem/toplum arasındaki bağ en az iki video kanıtıyla kurulup sınıfta sözlü ifade edilir; genel dönem bilgisi video kanıtının yerine geçmez.","source_locator":"basılı s.295 / PDF s.296 — Çözümleyebilme soru 11 / QR video gerekli"}},
