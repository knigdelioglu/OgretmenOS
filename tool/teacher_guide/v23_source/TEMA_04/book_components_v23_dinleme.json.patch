+    "T4_G04_P287_289_VIDEO_ANLAM": {"q1_anadolu_insani":{"value":"Belirli cevap Anadolu İnsanı / Fedakârlık videosu izlenmeden verilmez. Öğrenci ön bilgisindeki Anadolu insanı özelliklerinden hangilerinin videodaki somut davranış, söz, olay veya çalışma biçimiyle karşılık bulduğunu kanıt göstererek yazar.","source_locator":"basılı s.287 / PDF s.288 — Metni Anlayalım soru 1 / QR video gerekli"},"q2_zihin_haritasi":{"value":{"tema":"Video izlenerek genellenir; tek olay adı tema yerine geçmez.","konu":"Videoda ele alınan somut kişi/olay/yaşam kesiti üzerinden belirlenir.","ana_dusunce":"Videonun konu üzerinden vurguladığı temel yargı, medya kanıtıyla gerekçelendirilir.","yardimci_dusunceler":"Ana düşünceyi destekleyen en az iki ayrı video ayrıntısı seçilir.","bilgilerin_sunulusu":"Görüntü, ses, anlatım ve seçilen olayların bilgiyi nasıl sunduğu videodan örneklenir."},"source_locator":"basılı s.288 / PDF s.289 — Metni Anlayalım soru 2 / QR video gerekli"},"q3_kisi_duygu_dusunce":{"value":"Belirli duygu/düşünce video izlenmeden adlandırılmaz. Çıkarım 'gözlenen davranış/söz/ses tonu → olası duygu veya düşünce' zinciriyle ve en az bir medya kanıtıyla kurulmalıdır.","source_locator":"basılı s.289 / PDF s.290 — Metni Anlayalım soru 3 / QR video gerekli"},"q4_tahmin_tespit":{"value":"Dinleme öncesindeki tahmin ile video sonrasındaki tespit iki ayrı sütunda tutulur. Her değişiklik için hangi görüntü, söz, olay veya ses unsurunun tahmini doğruladığı ya da değiştirdiği belirtilir.","source_locator":"basılı s.289 / PDF s.290 — Metni Anlayalım soru 4 / QR video gerekli"}},
+    "T4_G04_P289_291_BELGESEL_GUVEN": {"q5_belgesel_kurgu":{"value":"Belgesel gerçek kişi/olaylara dayanabilir; ancak çekim, seçme, sıralama, kurgu, ses ve anlatıcı tercihleriyle sunulur. Fedakârlık videosunun türe uygunluğu ancak videodaki gerçeklik iddiası ile bu sunum seçimleri birlikte incelenerek değerlendirilir.","source_locator":"basılı s.289 / PDF s.290 — Metni Anlayalım soru 5 / QR video gerekli"},"q6_oznel_nesnel":{"value":"Öznel ve nesnel ifadelerin kendileri video izlenmeden listelenmez. Öğrenci nesnel ifadeyi dışarıdan doğrulanabilir bilgi/olgu; öznel ifadeyi yorum, değerlendirme veya kişisel yargı ölçütüyle ayırır ve videodan örnek verir.","source_locator":"basılı s.290 / PDF s.291 — Metni Anlayalım soru 6 / QR video gerekli"},"q7_inandiricilik_guven":{"value":"Q6'da belirlenen öznel/nesnel unsurların kaynağı, doğrulanabilirliği, bağlamı ve sunuluş biçimi incelenir. Nesnel görünen her ifade otomatik güvenilir, öznel her ifade otomatik güvensiz sayılmaz; kanıt ve kaynak ilişkisi gerekçelendirilir.","source_locator":"basılı s.290 / PDF s.291 — Metni Anlayalım soru 7 / QR video gerekli"},"q8_acik_ortuk_ileti":{"value":"Açık ileti videoda doğrudan ifade edilen yargı/mesajdan; örtük ileti ise olay, davranış, görüntü-ses birlikteliği veya bağlamdan çıkarılır. Belirli iletiler video izlenmeden rehberde doldurulmaz.","source_locator":"basılı s.290 / PDF s.291 — Metni Anlayalım soru 8 / QR video gerekli"},"q9_ileti_guvenilirligi":{"value":"Q8'de çıkarılan iletiler; dayandıkları görüntü/söz/olay, kaynak açıklığı, bağlam bütünlüğü ve belgeselin seçme-kurgu tercihleri üzerinden sorgulanır. Sonuç kanıtlı olmalıdır.","source_locator":"basılı s.290 / PDF s.291 — Metni Anlayalım soru 9 / QR video gerekli"},"q10_karakter_duygu_dusunce":{"value":"Karakterin/kişilerin duygu ve düşünceleri yalnız davranış, söz, ses tonu, yüz ifadesi veya olay içindeki tercihler gibi gözlenebilir video kanıtlarından çıkarılır; hazır sıfat listesi verilmez.","source_locator":"basılı s.291 / PDF s.292 — Metni Anlayalım soru 10 / QR video gerekli"},"q11_ozet_caliskanlik":{"value":"Özet videonun ana olay ve iletilerini ayrıntıya boğmadan kapsamalı; öğrenme ve kavrama sürecinde çalışkanlığın önemini videodaki gerçekten gözlenen davranış/olayla ilişkilendirmelidir. Video izlenmeden örnek olay uydurulmaz.","source_locator":"basılı s.291 / PDF s.292 — Metni Anlayalım soru 11 / QR video gerekli"}},
